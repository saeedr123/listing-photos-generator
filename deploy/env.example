# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The subdomain the app runs on. Its DNS A record must point at this server.
# The name is the owner's choice. Example only:
LPG_DOMAIN=tools.example.com

# Database. Choose a long random password of letters and digits only,
# because it is placed inside a connection URL. For example the output of:
#   openssl rand -hex 32
POSTGRES_USER=lpg
POSTGRES_DB=lpg
POSTGRES_PASSWORD=

# First admin account. Used once, on the first start, when no admin exists.
# Remove both values from this file after the first start.
LPG_SEED_ADMIN_EMAIL=
LPG_SEED_ADMIN_PASSWORD=
