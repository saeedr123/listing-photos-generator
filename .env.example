# Listing Photos Generator environment example
# Copy to .env and fill in real values. Never commit a real .env file.
# No real secrets are stored in this repository.

# Database (PostgreSQL, hosted or containerized; no local Postgres is assumed)
DATABASE_URL="postgresql://user:password@host:5432/listing_photos_generator?schema=public"

# Web app
NEXT_PUBLIC_APP_URL="https://placeholder.example.com"
APP_URL="https://placeholder.example.com"

# Auth (provider and secret to be confirmed; placeholder only)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://placeholder.example.com"

# Object storage for uploads, renders, and exports (provider to be confirmed)
OBJECT_STORAGE_PROVIDER=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# Stripe (on hold; no real keys; price and account to be decided by Ali)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_ANNUAL=""

# AI provider (to be confirmed; no real keys)
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""

# Email (provider to be confirmed)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
