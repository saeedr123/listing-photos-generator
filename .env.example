# Listing Photos Generator environment example
# Copy to .env and fill in real values. Never commit a real .env file.
# No real secrets are stored in this repository.

# Database (PostgreSQL, hosted or containerized; no local Postgres is assumed)
DATABASE_URL="postgresql://user:password@host:5432/listing_photos_generator?schema=public"
# Direct (not pooled) URL for migrations, as Neon on Vercel provides it.
# scripts/vercel-build.mjs uses it when set. Optional elsewhere.
DATABASE_URL_UNPOOLED=""
# Vercel build only: run migrations on a non production build too (for
# preview deployments that each get their own database branch).
LPG_MIGRATE_ON_BUILD=""
# Where config/ and packages/ are, if the app cannot find them by itself.
LPG_REPO_ROOT=""

# Web app
# Production refuses to start on the in-memory development store when
# DATABASE_URL is missing. Set this to "true" only for a local test of a
# production build without a database. Never on a real server.
LPG_ALLOW_MEMORY_STORE=""
# How many reverse proxies sit in front of the app (default 1). Rate limits
# read the visitor address from X-Forwarded-For, this many places from the
# right. Raise it if a CDN is added in front of the proxy.
LPG_TRUSTED_PROXY_HOPS="1"

# First admin account. Used by npm run db:setup and the container start
# script only when no admin exists yet. Never commit real values. Remove
# them after the first admin has signed in.
LPG_SEED_ADMIN_EMAIL=""
LPG_SEED_ADMIN_PASSWORD=""

NEXT_PUBLIC_APP_URL="https://placeholder.example.com"
APP_URL="https://placeholder.example.com"

# Auth (provider and secret to be confirmed; placeholder only)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://placeholder.example.com"

# Object storage for uploads, renders, and exports (provider to be confirmed)
# Leave OBJECT_STORAGE_PROVIDER empty in development to use the local file
# adapter (development only). In production an empty value means storage is
# not configured: no provider is picked for you. "local_file" may be named
# explicitly for a local production build test, or for the deploy/ server.
# On Vercel (decided 2026-11-18): "vercel_blob", with BLOB_READ_WRITE_TOKEN,
# which Vercel sets when a Blob store is connected. Never commit the token.
OBJECT_STORAGE_PROVIDER=""
BLOB_READ_WRITE_TOKEN=""
# Folder for the local file adapter. Default: .local-storage at the repo root.
OBJECT_STORAGE_LOCAL_DIR=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# Stripe (on hold; no real keys; price and account to be decided by Ali)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_ANNUAL=""

# AI provider (to be confirmed; no real keys)
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""

# Email (provider to be confirmed)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
